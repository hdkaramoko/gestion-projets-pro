# Réglages Django locaux. En production, utiliser config.settings.production.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DEBUG=true

# Base SQLite locale utilisée par défaut.
DB_ENGINE=sqlite

# Configuration PostgreSQL SSP Cloud (requise avec DB_ENGINE=postgresql).
POSTGRES_HOST=postgresql-cnpg-158593-rw
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=
POSTGRES_PASSWORD=
